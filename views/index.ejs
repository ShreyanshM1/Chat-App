<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini WhatsApp</title>
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <h1>All Chats!</h1>
    <form method="get" action="/chats/new">
      <button class="btn">Add New Chat</button>
    </form>
    <div class="card">
      <% for(let chat of chats){ %>
      <div class="chat">
        <p><b>From: </b><i><%= chat.from %></i></p>
        <div class="msg">
          <p><%= chat.msg %></p>
          <form method="get" action="/chats/<%= chat.id %>/edit">
            <button>Edit</button>
          </form>
        </div>
        <p><b>Recieved by</b> <i><%= chat.to %></i></p>
        <p><b>Time: </b><%= chat.created_at.toString().split(" ")[4] %></p>
        <p><b>Date: </b><%= chat.created_at.toString().split(" ").slice(0,4).join("-") %></p>
        <form method="post" action="/chats/<%= chat.id %>?_method=DELETE">
          <button class="del">Delete</button>
        </form>
      </div>
      <% } %>
    </div>  
    <script src="/JS/script.js"></script>
  </body>
</html>
